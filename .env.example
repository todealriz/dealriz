# ── DealRiz environment ──────────────────────────────────────────────
# Copy to .env for local dev:  cp .env.example .env

# Database — local dev (SQLite, zero-config)
DATABASE_URL="file:./dev.db"
# Production (Neon Postgres): set to your Neon connection string AND switch
# prisma/schema.prisma provider from "sqlite" to "postgresql".

# Canonical public URL (used for sitemap, emails, share links)
SITE_URL="http://localhost:3000"

# Admin dashboard + /api/admin/* + /api/jobs/* auth.
# Generate:  openssl rand -hex 32
# Dev convenience: if unset and NODE_ENV != production, admin routes are open.
ADMIN_API_KEY=""

# Auto-approve ingested deals (default false = human review in /admin queue).
# The seed script passes autoApprove:true explicitly, so leave this false.
AUTO_APPROVE_INGESTED="false"
# Minimum discount % for RULE-BASED auto-approve (default 30). A new ingested
# deal auto-publishes when: discountPct >= this AND its store is "trusted"
# (the store already has ≥1 human-approved deal) AND it has an image.
# Price-drop deals (>10% vs 30-day median) ALWAYS auto-approve regardless.
AUTO_APPROVE_MIN_DISCOUNT="30"

# Email (Resend) — optional in dev; without a key, emails log to console.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DealRiz <deals@dealriz.com>"

# Salt mixed into the SHA-256 IP hash for click logs (any random string).
CLICK_SALT="change-me-in-production"

# ── Optional: Claude scoring (off by default — v1 heuristic costs $0) ──────
USE_CLAUDE_SCORING="false"
ANTHROPIC_API_KEY=""

# ── Advertising (Google AdSense) ─────────────────────────────────────────
# Publisher ID from your AdSense account (sign up at https://www.google.com/adsense,
# then it appears as "ca-pub-XXXXXXXXXXXXXXXX"). Until this is set, the site
# renders clearly-labeled placeholder boxes that reserve the exact ad space,
# so turning ads on later causes zero layout shift.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# Publisher ID for /ads.txt (the authorized-sellers file Google requires).
# Same value as above, without any prefix: ca-pub-XXXXXXXXXXXXXXXX.
# Until set, /ads.txt serves #-comment instructions instead of a seller line.
ADSENSE_PUBLISHER_ID=""

# ── Affiliate network credentials (fill in as you implement adapters) ─────
# Amazon Product Advertising API 5.0
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_PAAPI_PARTNER_TAG=""
# ShareASale — REAL adapter (lib/affiliates/shareasale.ts), registered when
# ENABLE_SHAREASALE_FEED="true". Without credentials the adapter warns and
# ingests nothing — it can never silently join the pipeline half-configured.
# Where to find each value (ShareASale is now an Awin Group company; dashboard
# locations may have shifted with the migration — search the dashboard for
# "API" if a path below moved):
#   SHAREASALE_AFFILIATE_ID — your affiliate (user) ID: shown at the top of the
#     ShareASale affiliate dashboard after login; also the u= value in any
#     tracking link from Links → "Get a Link/Banner".
#   SHAREASALE_API_TOKEN / SHAREASALE_API_SECRET — ShareASale dashboard →
#     your account/API section (the API management page lists the token and
#     secret; keep the secret out of git — .env is never committed).
#   SHAREASALE_MERCHANT_IDS — comma-separated merchant IDs to search (from the
#     merchant search in your dashboard; the numeric ID is in the merchant's
#     profile page URL). Optional: empty = search across your joined merchants.
#   SHAREASALE_KEYWORDS — comma-separated keywords for the product search API
#     (e.g. "shoes,headphones,laptop"). Default: "sale".
#   SHAREASALE_DATAFEED_URLS — comma-separated per-merchant product datafeed
#     DOWNLOAD URLs. In the dashboard open the merchant → Datafeed and copy the
#     download link (it's personalized to your account). Optional.
# Docs: https://account.shareasale.com/a-apiVersion2.cfm (now redirects to
# Awin — accounts are migrating); the implemented contract was verified
# against real recorded API traffic — see the header of shareasale.ts.
ENABLE_SHAREASALE_FEED="false"
SHAREASALE_API_TOKEN=""
SHAREASALE_API_SECRET=""
SHAREASALE_AFFILIATE_ID=""
SHAREASALE_MERCHANT_IDS=""
SHAREASALE_KEYWORDS=""
SHAREASALE_DATAFEED_URLS=""
# Optional tuning: max deals per ingest run (default 500), per-feed row cap
# (default 3000), only ingest discounted feed rows (default true),
# include coupon deals (default false — coupons carry no pricing yet).
SHAREASALE_MAX_DEALS="500"
SHAREASALE_FEED_LIMIT="3000"
SHAREASALE_FEED_DISCOUNT_ONLY="true"
SHAREASALE_INCLUDE_COUPONS="false"
# CJ Affiliate
CJ_API_TOKEN=""
CJ_CID=""
# Impact — set to "true" to register the Impact adapter (Best Buy, Walmart,
# Target and 1000s of other merchants). Without credentials the adapter warns
# and ingests nothing — it can never silently join the pipeline half-configured.
ENABLE_IMPACT_FEED="false"
# Impact Radius (https://app.impact.com → Settings → API). HTTP Basic auth:
# AccountSID as username, AuthToken as password.
# Docs: https://integrations.impact.com/impact-brand/reference
# NOTE: verify the catalog/item endpoints + field mappings in
# lib/affiliates/impact.ts against the docs before trusting it in production.
IMPACT_ACCOUNT_SID=""
IMPACT_AUTH_TOKEN=""
# Optional: pin one Impact catalog ID (see adapter logs for available IDs).
IMPACT_CATALOG_ID=""
